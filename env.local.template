NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Google Search Console HTML tag token (content value only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Used by next-sitemap if set (production canonical host).
SITE_URL=

# Razorpay (Standard Checkout + webhooks). Key ID is returned to the browser for checkout only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Set to "development" to unlock Pro-style tool features locally (QR Pro, bulk compress). Omit in production.
FREEMODE=
# Dev only: set to "1" to skip all Supabase calls in middleware when your network cannot reach Supabase (stops long hangs).
SKIP_SUPABASE_MIDDLEWARE=
