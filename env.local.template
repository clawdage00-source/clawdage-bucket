NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public site URL (canonical / OG). Production: https://clawdage.com — local dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://clawdage.com
SUPABASE_SERVICE_ROLE_KEY=
# Signs admin gate cookies (falls back to SUPABASE_SERVICE_ROLE_KEY if unset)
ADMIN_SESSION_SECRET=
# Admin panel access code (defaults to 006706 if unset)
ADMIN_ACCESS_CODE=006706

# Optional: Google Search Console HTML tag token (content value only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Optional override for next-sitemap (defaults to NEXT_PUBLIC_SITE_URL). Production: https://clawdage.com
SITE_URL=https://clawdage.com

# Razorpay (Standard Checkout + webhooks). Key ID is returned to the browser for checkout only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Set to "development" to unlock Pro-style tool features locally (QR Pro, bulk compress). Omit in production.
FREEMODE=
# Dev only: set to "1" to skip all Supabase calls in middleware when your network cannot reach Supabase (stops long hangs).
SKIP_SUPABASE_MIDDLEWARE=
